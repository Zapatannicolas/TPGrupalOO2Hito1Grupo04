<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="datos.Festival" table="festival">

        <!-- ID -->
        <id name="id" column="idFestival">
            <generator class="identity"/>
        </id>

        <!-- Atributos - Columnas -->
        <property name="nombre" column="nombre" type="string" not-null="true"/>

        <property name="temporada" column="temporada" type="string" not-null="true"/>

        <property name="fechaInicio" column="fechaInicio" type="date" not-null="true"/>

        <property name="fechaFin" column="fechaFin" type="date" not-null="true"/>

        <!-- Relación 1:N con UnidadVenta -->
        <set name="unidadesVenta"
             table="unidadVenta"
             inverse="true"
             lazy="true"
             fetch="select">

            <key column="idFestival" not-null="true"/>

            <one-to-many class="datos.UnidadVenta"/>

        </set>

        <!-- Relación 1:N con Pedido -->
        <set name="pedidos"
             table="pedido"
             inverse="true"
             lazy="true"
             fetch="select">

            <key column="idFestival" not-null="true"/>

            <one-to-many class="datos.Pedido"/>

        </set>

    </class>

</hibernate-mapping>