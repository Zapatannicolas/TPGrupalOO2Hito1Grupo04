<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Plato" table="plato">

        <!-- ID -->
        <id name="idPlato" column="idPlato">
            <generator class="identity"/>
        </id>

        <!-- Atributos - Columnas -->
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="precio" column="precio" type="float" not-null="true"/>
        <property name="costo" column="costo" type="float" not-null="true"/>

		<!-- Relacion con listas (otras clases) -->
		<many-to-one name="unidadVenta" class="datos.UnidadVenta" column="idUnidadVenta"
			not-null="false" />

    </class>
</hibernate-mapping>